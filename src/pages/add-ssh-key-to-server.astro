const path = '/add-ssh-key-to-server';
const title = 'How to Add an SSH Key to a Server (authorized_keys)';
const description =
  'Install a public key on a Linux server with ssh-copy-id or by hand, get authorized_keys permissions right, disable password logins and fix publickey errors.';

const toc = [
  { id: 'how-it-works', label: 'How key login works' },
  { id: 'steps', label: 'Add an SSH key to a server, step by step' },
  { id: 'ssh-copy-id', label: 'What ssh-copy-id does' },
  { id: 'other-user', label: 'Add a key for another user' },
  { id: 'authorized-keys', label: 'Inside authorized_keys' },
  { id: 'permissions', label: 'Permissions sshd requires' },
  { id: 'disable-passwords', label: 'Disable password login safely' },
  { id: 'cloud', label: 'Cloud servers and panels' },
